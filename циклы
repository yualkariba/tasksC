/*4.Даны три целых числа. Найти количество положительных чисел в исходном наборе.*/
#include <stdio.h>
int main() {
int x, y, z;
int count=0;
scanf("%d%d%d", &x, &y, &z);
if (x > 0) {
count++;
} else if (y > 0) {
count++;
} else if (z > 0) {
count++;
}
printf("%d", count);
}
