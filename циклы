/*1.Дано целое число. Если оно является положительным, то прибавить к
нему 1; в противном случае не изменять его. Вывести полученное число.*/
==================
#include <stdio.h>
int main() {
int x;
scanf("%d", &x);
if (x > 0) {
x++;
}
printf("%d", x);
}
