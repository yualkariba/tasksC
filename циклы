/*7.Дан номер месяца — целое число в диапазоне 1–12 (1 — январь, 2 — февраль и т. д.). Вывести название соответствующего времени года («зима»,
«весна», «лето», «осень»).*/
==================
#include <stdio.h>
#include <locale.h>
int main() {
	setlocale(LC_ALL, "");
	int month;
	scanf("%d", &month);
	if (month == 12 || month == 1 || month == 2) {
		printf("Месяц %d — зима", month);
	} 
	else if (month >= 3 && month <= 5) {
		printf("Месяц %d — весна", month);
	} 
	else if (month >= 6 && month <= 8) {
		printf("Месяц %d — лето", month);
	} 
	else { 
		printf("Месяц %d — осень", month);
	}
	printf("\n");
	return 0;
}
