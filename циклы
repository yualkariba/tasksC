/*5.Даны два числа. Вывести большее из них.*/
==================
#include <stdio.h>
int main() {
    int x, y;
    if (scanf("%d%d", &x, &y) != 2) {
        return 1;
    }
    if (x > y) {
        printf("%d\n", x);
    } else if (y > x) {
        printf("%d\n", y);
    } else {
        printf("Числа равны\n");
    }
    return 0;
}
